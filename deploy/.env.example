# ---- Addresses ----
# Until the domains are set up the site/admin are reachable by IP on 8120/8121.
# After configuring the host nginx (deploy/nginx.conf.example) switch to
# 127.0.0.1:8120 / 127.0.0.1:8121 so only nginx can reach them.
SITE_BIND=0.0.0.0:8120
ADMIN_BIND=0.0.0.0:8121
# Public origin of the site (canonical URLs, sitemap, admin "open site" link)
PUBLIC_BASE_URL=http://169.58.31.233:8120

# ---- Secrets (deploy.sh generates them when missing) ----
POSTGRES_PASSWORD=
JWT_SECRET=
REVALIDATE_SECRET=

# ---- First administrator (created only when no users exist) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Bosh admin

# ---- League rules (confirm with the league regulations) ----
POINTS_WIN=3
POINTS_DRAW=1
POINTS_LOSS=0
# Substitutes allowed in a matchday squad (0 = no limit)
LINEUP_BENCH_MAX=9

# ---- Site links ----
TICKETS_URL=https://gtickets.uz
SHOP_URL=
SOCIAL_INSTAGRAM=
SOCIAL_TELEGRAM=
SOCIAL_YOUTUBE=
OCR_LANG=eng

# ---- Search engines & analytics (optional) ----
# Search Console / Yandex Webmaster / Bing: paste only the verification token (content="…")
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
BING_SITE_VERIFICATION=
# GA4 measurement id (G-XXXXXXX); empty = no analytics script at all
GA_MEASUREMENT_ID=

# ---- Telegram Live-pult bot (optional) ----
# Token from @BotFather. Never commit it: this file stays on the server only.
# Empty = bot disabled. Operators get access by the phone number set on their user card.
TELEGRAM_BOT_TOKEN=

# ---- Instagram feed on /media (optional) ----
# Usually connected in the admin → Instagram. A token here is used only on first
# start when nothing is connected yet. Never commit it.
INSTAGRAM_ACCESS_TOKEN=

# AI service (OpenAI / Gemini). Keys themselves are entered in the admin
# (AI-servis → Ulanishlar) and stored encrypted with AI_MASTER_KEY.
# deploy.sh generates both values; changing AI_MASTER_KEY makes saved keys unreadable.
AI_MASTER_KEY=
AI_INTERNAL_TOKEN=
