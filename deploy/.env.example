# ---- Addresses ----
# With a domain pointed at the server Caddy gets HTTPS certificates automatically:
#   SITE_ADDRESS=unitedmfl.com, www.unitedmfl.com
#   ADMIN_ADDRESS=admin.unitedmfl.com
# Before DNS is ready you can test by IP: site on :80, admin on :8081 (plain HTTP).
SITE_ADDRESS=:80
ADMIN_ADDRESS=:8081
# Public origin of the site (canonical URLs, sitemap, admin "open site" link)
PUBLIC_BASE_URL=http://169.58.31.233

# ---- Secrets (deploy.sh generates them when missing) ----
POSTGRES_PASSWORD=
JWT_SECRET=

# ---- First administrator (created only when no users exist) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Bosh admin

# ---- League rules (confirm with the league regulations) ----
POINTS_WIN=3
POINTS_DRAW=1
POINTS_LOSS=0

# ---- Site links ----
TICKETS_URL=https://gtickets.uz
SHOP_URL=
SOCIAL_INSTAGRAM=
SOCIAL_TELEGRAM=
SOCIAL_YOUTUBE=
OCR_LANG=eng
