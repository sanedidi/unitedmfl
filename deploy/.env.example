# ---- Addresses ----
# Until the domains are set up the site/admin are reachable by IP on 8120/8121.
# After configuring the host nginx (deploy/nginx.conf.example) switch to
# 127.0.0.1:8120 / 127.0.0.1:8121 so only nginx can reach them.
SITE_BIND=0.0.0.0:8120
ADMIN_BIND=0.0.0.0:8121
# Team registration site (separate address; closed until a link is opened in the admin)
REGISTER_BIND=0.0.0.0:8122
# Public origin of the site (canonical URLs, sitemap, admin "open site" link)
PUBLIC_BASE_URL=http://169.58.31.233:8120
# Public origin of the registration site — the admin builds links from it
# (https://ariza.unitedmfl.uz after the domain is set up)
REGISTER_PUBLIC_URL=http://169.58.31.233:8122
# «Yordam» link on the registration site
REGISTER_HELP_URL=https://t.me/united_mfl

# ---- Secrets (deploy.sh generates them when missing) ----
POSTGRES_PASSWORD=
JWT_SECRET=
REVALIDATE_SECRET=

# ---- First administrator (created only when no users exist) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Bosh admin

# ---- League rules (confirm with the league regulations) ----
POINTS_WIN=3
POINTS_DRAW=1
POINTS_LOSS=0
# Substitutes allowed in a matchday squad (0 = no limit)
LINEUP_BENCH_MAX=9

# ---- Site links ----
TICKETS_URL=https://gtickets.uz
SHOP_URL=
SOCIAL_INSTAGRAM=
SOCIAL_TELEGRAM=
SOCIAL_YOUTUBE=
OCR_LANG=eng

# ---- Search engines & analytics (optional) ----
# Search Console / Yandex Webmaster / Bing: paste only the verification token (content="…")
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
BING_SITE_VERIFICATION=
# GA4 measurement id (G-XXXXXXX); empty = no analytics script at all
GA_MEASUREMENT_ID=

# ---- Telegram Live-pult bot (optional) ----
# Token from @BotFather. Never commit it: this file stays on the server only.
# Empty = bot disabled. Operators get access by the phone number set on their user card.
TELEGRAM_BOT_TOKEN=

# ---- Instagram feed on /media (optional) ----
# Usually connected in the admin → Instagram. A token here is used only on first
# start when nothing is connected yet. Never commit it.
INSTAGRAM_ACCESS_TOKEN=

# AI service (OpenAI / Gemini). Keys themselves are entered in the admin
# (AI-servis → Ulanishlar) and stored encrypted with AI_MASTER_KEY.
# deploy.sh generates both values; changing AI_MASTER_KEY makes saved keys unreadable.
AI_MASTER_KEY=
AI_INTERNAL_TOKEN=

# ---- SMS for the registration site (optional) ----
# Eskiz (notify.eskiz.uz) account: representatives confirm their phone with a code.
# Empty = phone verification is switched off. Eskiz approves message templates:
# SMS_CODE_TEXT must match an approved template (%s is the code).
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
SMS_CODE_TEXT=

# ---- Match tickets (optional) ----
# Payme: merchant cabinet → callback URL https://<domain>/api/v1/pay/payme
PAYME_MERCHANT_ID=
PAYME_KEY=
# Click: callback URLs https://<domain>/api/v1/pay/click/prepare and .../complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
# Face matching service (biometrics must stay in Uzbekistan). Empty = manual photo check at the gate.
FACE_SERVICE_URL=
# 1 = instant test payments (only when APP_ENV is not production)
TEST_PAYMENTS=
