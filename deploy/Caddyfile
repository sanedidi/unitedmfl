{
	# requests arrive from the host nginx: keep the real client IP from X-Forwarded-For
	servers {
		trusted_proxies static private_ranges
	}
	auto_https off
}

(security) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
}

(api) {
	# SSE live stream must not be buffered or compressed
	handle /api/* {
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}
	handle /uploads/* {
		header Cache-Control "public, max-age=2592000, immutable"
		reverse_proxy api:8080
	}
}

# Public site (Next.js SSR)
{$SITE_ADDRESS} {
	import security
	import api
	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}
}

# Admin panel (React SPA) — same-origin /api, so no CORS is needed
{$ADMIN_ADDRESS} {
	import security
	header X-Robots-Tag "noindex, nofollow"
	import api
	handle {
		encode zstd gzip
		root * /srv/admin
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
