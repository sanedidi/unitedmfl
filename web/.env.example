# Public origin of the site, used for canonical URLs and sitemap
NEXT_PUBLIC_SITE_URL=https://unitedmfl.com
# Optional social links shown in the footer
SOCIAL_INSTAGRAM=
SOCIAL_TELEGRAM=
SOCIAL_YOUTUBE=
# Default ticket link in the header
TICKETS_URL=https://gtickets.uz
